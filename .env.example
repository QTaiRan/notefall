# notefall — environment template. Copy to `.env` (git-ignored) and
# fill in. `.env` is loaded by Vite (dev + build) AND auto-sourced by
# `scripts/upload-r2.sh`. Never commit real credentials.

# ───────── Vite (optional) ─────────
# Override for the HQ piano sample CDN. Used by Vite at build time;
# baked into the bundle, not read at runtime.
#
# Default (when unset): https://samples.notefall.app/salamander-v3-close
#
# Production builds normally get this from `.env.production`. Set it
# here only to point a staging / preview build at a different bucket
# (local mirror or regional R2 distribution). No trailing slash.
VITE_SAMPLES_BASE_URL=

# Anonymous usage analytics (PostHog EU Cloud). Entirely OFF unless a
# key is set AND it's a production build — dev never sends anything and
# never even loads posthog-js. Leave blank to ship without analytics.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ───────── R2 (Cloudflare) — required by `npm run upload-r2` ─────────
# Account ID for the Cloudflare account that owns the samples bucket
# (32 hex chars).
R2_ACCOUNT_ID=
# Bucket name where the Salamander OGG samples live.
R2_BUCKET=notefall-samples
# R2 API token (Object Read & Write, scoped to the bucket). Issued via
# dash.cloudflare.com/<account>/r2/api-tokens.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
