# Where the HQ (Salamander) piano OGG samples are served from.
# Falls back to `/samples/salamander-v3-close` (local public/ dir)
# when unset — convenient for dev. For prod builds, point at the R2
# bucket + prefix (do NOT include a trailing slash).
#
# Example for a custom domain bound to R2:
#   VITE_SAMPLES_BASE_URL=https://samples.notefall.app/salamander-v3-close
#
# Example for the default r2.dev public bucket:
#   VITE_SAMPLES_BASE_URL=https://pub-<hash>.r2.dev/salamander-v3-close
VITE_SAMPLES_BASE_URL=
