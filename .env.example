# Override for the HQ piano sample CDN. Used by Vite at build time;
# the value is baked into the bundle and not read at runtime.
#
# Default (when unset): https://samples.notefall.app/salamander-v3-close
#
# Set this if you want to point a staging / preview build at a
# different bucket — e.g. a local mirror or a regional R2 distribution.
# No trailing slash.
VITE_SAMPLES_BASE_URL=
